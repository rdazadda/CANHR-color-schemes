* CANHR graph scheme: the brand colors of the Center for Alaska Native Health
* Research on top of Stata's s2color scheme.
*
*   p1   Blue           35  97 146   #236192
*   p2   Gold          255 205   0   #FFCD00
*   p3   Green         113 152  74   #71984A
*   p4   Orange        223 106  46   #DF6A2E
*   p5   Cyan          135 209 230   #87D1E6
*   p6   Magenta       244  81 151   #F45197
*   p7   Dark Blue      17  28  78   #111C4E
*   p8   Brown         119  77  40   #774D28
*   p9   Dark Grey     102 102  93   #66665D
*   p10  Custard       246 223 164   #F6DFA4
*   p11  Light Blue    196 207 218   #C4CFDA
*   p12  Light Grey    200 200 200   #C8C8C8
*   p13  Deep Teal      22  91  99   #165B63
*   p14  Tundra Green   82 107  70   #526B46
*   p15  Warm Berry    164  61  82   #A43D52
*        Warm Ivory    247 244 236   #F7F4EC
*        Charcoal       38  50  56   #263238
*        Muted Gold    214 170  81   #D6AA51
*
* Stata has fifteen series styles (p1-p15), so colors after the fifteenth are
* not assigned to series automatically. Use their RGB values directly, for
* example color("214 170 81").

#include s2color

sequence 1210
label "canhr"

* Series colors. Lines, markers, bars, boxes, areas and pie slices all take
* their color from these.
color p1    "35 97 146"
color p2    "255 205 0"
color p3    "113 152 74"
color p4    "223 106 46"
color p5    "135 209 230"
color p6    "244 81 151"
color p7    "17 28 78"
color p8    "119 77 40"
color p9    "102 102 93"
color p10   "246 223 164"
color p11   "196 207 218"
color p12   "200 200 200"
color p13   "22 91 99"
color p14   "82 107 70"
color p15   "164 61 82"

* s2color fills areas at 80%, pie slices at 90% and boxes at 50% intensity,
* which washes the colors out. Use the full colors, and draw box-plot medians
* as thin black lines so they stay visible on a solid box.
intensity p     full
intensity pie   full
intensity box   full
medtypestyle boxplot   cline
linestyle box_median   foreground

* Background and text
color background         white
color plotregion         white
color matrix_plotregion  white
color legend             white
color legend_line        white
color heading            "35 97 146"
color subheading         "35 97 146"
color axis_title         "35 97 146"
color body               black
color small_body         black
color key_label          black

* Axes and grid lines
color axisline           "102 102 93"
color tick               "102 102 93"
color tick_label         "102 102 93"
color grid               "200 200 200"
color major_grid         "200 200 200"
color minor_grid         white
anglestyle vertical_tick horizontal

* Other plot elements
color histogram          "35 97 146"
color histback           white
color ci_line            "35 97 146"
color ci_area            "196 207 218"
color ci_arealine        "35 97 146"
color refline            "102 102 93"
color refmarker          "35 97 146"
color matrixmarkline     "35 97 146"
color mat_label_box      white
color clegend            white
color clegend_line       white
