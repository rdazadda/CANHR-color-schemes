Package: canhrcolors
Title: CANHR Colors for R and Stata
Version: 1.1.0
Authors@R: c(
    person("Raymond Dacosta", "Azadda", email = "rdazadda@alaska.edu", role = c("aut", "cre")),
    person("Andrew", "Grogan-Kaylor", role = "aut"),
    person("KyungSook", "Lee", role = "aut")
